# Runtime (production, development, or test)
ENVIRONMENT=development
COMPOSE_PROFILES=

# PostgreSQL
POSTGRES_PASSWORD=websearch_password
POSTGRES_MAX_CONNECTIONS=64
POSTGRES_SHARED_BUFFERS=128MB
POSTGRES_MEM_LIMIT=768m

# Search and embeddings
# Required by indexing and search: perplexity/pplx-embed-v1-0.6b via OpenRouter.
OPENROUTER_API_KEY=
OPENSEARCH_INDEX_NAME=documents-hybrid-v2
OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m
OPENSEARCH_MEM_LIMIT=1g

# Frontend
ALLOWED_HOSTS=localhost,127.0.0.1,frontend
# Optional; enables stable session hashing.
ANALYTICS_SALT=
FRONTEND_MEM_LIMIT=384m
DB_POOL_MIN_FRONTEND=1
DB_POOL_MAX_FRONTEND=4

# Indexer
INDEXER_API_URL=http://localhost:8081/documents
INDEXER_API_KEY=
INDEXER_MEM_LIMIT=384m
DB_POOL_MIN_INDEXER=1
DB_POOL_MAX_INDEXER=6

# Crawler (COMPOSE_PROFILES=crawler)
CRAWLER_SERVICE_URL=http://localhost:8082
CRAWL_CONCURRENCY=2
CRAWL_CONCURRENCY_CRAWLER=2
CRAWLER_MEM_LIMIT=384m
DB_POOL_MIN_CRAWLER=1
DB_POOL_MAX_CRAWLER=4

# R2 link archive (required with COMPOSE_PROFILES=crawler)
# Set production values on the production host, outside Git.
R2_BUCKET=
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
LINK_ARCHIVE_MAX_PENDING_BYTES=536870912
LINK_ARCHIVE_MEM_LIMIT=768m

# Prometheus (optional monitoring profile)
PROMETHEUS_BIND_ADDRESS=127.0.0.1
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=7d
PROMETHEUS_MEM_LIMIT=256m

# Grafana (optional monitoring profile)
GRAFANA_BIND_ADDRESS=127.0.0.1
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
GRAFANA_MEM_LIMIT=256m
